APP_NAME=FolioPrior Auth
ENVIRONMENT=development

DATABASE_URL=sqlite:///./clinical_guidelines.db

FAISS_INDEX_PATH=./vector_store/index.faiss
FAISS_METADATA_PATH=./vector_store/metadata.json

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

TOP_K=8
LOG_LEVEL=INFO

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: enables the Determination Agent's LLM-generated rationale and
# real token/cost metrics in the observability dashboard. Leave both API keys
# blank to run fully offline with a deterministic, templated rationale instead.
#
# LLM_PROVIDER selects which key/SDK is used below - "anthropic" or "openai".
# Only the selected provider's key needs to be set.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LLM_MAX_TOKENS=500
LLM_INPUT_COST_PER_MILLION=1.0
LLM_OUTPUT_COST_PER_MILLION=5.0
